# =============================================================================
# ccmon — Issabel/Asterisk call-center monitor (.env.example)
# Copy to .env, fill in values, chmod 600 .env. NEVER commit .env.
# =============================================================================

# ---------- Application ----------
# production | development | demo   (demo = in-memory synthetic Issabel data, no PBX needed)
APP_MODE=production
# Services bind to loopback only; expose via Issabel httpd TLS reverse proxy (deploy/httpd/).
APP_HOST=127.0.0.1
APP_PORT=8080
# Display timezone for API/dashboard (storage is always UTC)
TZ=UTC
LOG_LEVEL=INFO
# Keep false in production: exposes /openapi.json (useful only for Hermes discovery)
OPENAPI_ENABLED=false

# ---------- App database (PostgreSQL is the production target) ----------
# sqlite is supported for development/tests only.
DATABASE_URL=postgresql+psycopg://ccmon:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/ccmon

# ---------- Issabel / Asterisk data sources (READ-ONLY MySQL user!) ----------
# Create with deploy/sql/readonly_grants.sql — SELECT-only, never use root/admin here.
ISSABEL_DB_HOST=127.0.0.1
ISSABEL_DB_PORT=3306
ISSABEL_DB_USER=ccmon_reader
ISSABEL_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
ISSABEL_DB_CDR=asteriskcdrdb
ISSABEL_DB_ASTERISK=asterisk
ISSABEL_DB_CALL_CENTER=call_center
ISSABEL_DB_CONNECT_TIMEOUT=5
ISSABEL_DB_READ_TIMEOUT=6
# Max rows any source query may return (abuse/cost guard)
ISSABEL_DB_MAX_ROWS=5000

# ---------- Asterisk AMI (READ-ONLY manager user, loopback only) ----------
# Snippet: deploy/ami/ccmon_manager.conf.example — no write/originate permissions.
AMI_ENABLED=true
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=ccmon_read
AMI_SECRET=CHANGE_ME_AMI_SECRET
AMI_TIMEOUT=3

# ---------- Telegram alerts ----------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Collector tuning ----------
COLLECT_LIVE_SECONDS=5
COLLECT_HISTORY_SECONDS=60
COLLECT_ROLLUP_MINUTES=60
# Staleness threshold (seconds): heartbeat older than this => dashboard shows "stale"
LIVE_STALE_AFTER_SECONDS=30
# Retention (days) for app DB tables; pruned hourly by the collector
RETENTION_SNAPSHOTS_DAYS=7
RETENTION_ROLLUPS_DAYS=400
RETENTION_ALERT_EVENTS_DAYS=180
RETENTION_AUDIT_DAYS=365

# ---------- Service health probes (systemctl is-active, unprivileged) ----------
PROBE_SERVICES=asterisk,issabeldialer,httpd,mariadb

# ---------- SLA policy (also editable at runtime via settings API) ----------
SLA_SECONDS=20
SLA_TARGET_PCT=80

# ---------- Auth ----------
# First admin: `ccmon create-admin --username X --password Y` (or these values,
# used by `ccmon init-db` when no users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_TTL_MINUTES=720
LOGIN_RATE_PER_MINUTE=5

# ---------- Rate limiting / abuse protection ----------
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_TOKEN_PER_MINUTE=60
# Report query guards
REPORT_MAX_DAYS=92
REPORT_MAX_ROWS=5000
